# Gujarat Yatra Companion - Environment Variables
# Copy this file to .env and fill in your values

# Optional: Google Maps API key for enhanced map features
# Get from: https://console.cloud.google.com/apis/credentials
# VITE_GOOGLE_MAPS_API_KEY=

# Optional: Google Places API key for business details
# Get from: https://console.cloud.google.com/apis/credentials
# VITE_GOOGLE_PLACES_API_KEY=

# Optional: Google Routes API key for advanced routing
# VITE_GOOGLE_ROUTES_API_KEY=

# Note: The application works without any API keys using:
# - OpenStreetMap for maps (Leaflet)
# - Nominatim for geocoding
# - Overpass API for place discovery
# - OSRM for route calculations
